# Hooks

## Structure

```
packages/client/src/hooks/
  use-agents.hook.ts       # TanStack Query hooks for agents API
  use-skills.hook.ts
  use-rules.hook.ts
  use-memory.hook.ts
  use-tasks.hook.ts
  use-projects.hook.ts
  use-settings.hook.ts
  use-theme.hook.ts        # Non-query hook: dark/light mode toggle
```

## TanStack Query Pattern

One hook file per entity. Export query and mutation hooks:

```typescript
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import type { Agent, CreateAgent, UpdateAgent } from '@atlas/shared';
import { api } from '@/lib/api';

const AGENTS_KEY = ['agents'] as const;

export function useAgents(): UseQueryResult<Agent[]> {
  return useQuery({
    queryKey: AGENTS_KEY,
    queryFn: () => api.get<Agent[]>('/agents'),
  });
}

export function useAgent(id: string): UseQueryResult<Agent> {
  return useQuery({
    queryKey: [...AGENTS_KEY, id],
    queryFn: () => api.get<Agent>(`/agents/${id}`),
    enabled: !!id,
  });
}

export function useCreateAgent() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (data: CreateAgent) => api.post<Agent>('/agents', data),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: AGENTS_KEY }),
  });
}

export function useUpdateAgent() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: ({ id, data }: { id: string; data: UpdateAgent }) =>
      api.put<Agent>(`/agents/${id}`, data),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: AGENTS_KEY }),
  });
}

export function useDeleteAgent() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (id: string) => api.delete(`/agents/${id}`),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: AGENTS_KEY }),
  });
}
```

## Rules

- Hook file names: `use-<entity>.hook.ts`.
- One file per entity, exporting all query/mutation hooks for that entity.
- Query keys are typed constants at the top of the file.
- All hooks have explicit return types.
- Use `enabled` option for conditional queries.
- Invalidate related queries in `onSuccess` of mutations.
- No direct `fetch()` calls in hooks -- use the `api` client from `@/lib/api`.

## Custom Non-Query Hooks

For non-data hooks (UI state, keyboard shortcuts, etc.), follow the same naming convention:

```typescript
export function useKeyboardShortcut(key: string, handler: () => void): void {
  // ...
}
```

- Cleanup effects (listeners, timers) in `useEffect` return.
- Return consistent shapes: `{ data, isLoading, error }` or domain-specific.
