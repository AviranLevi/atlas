# Copy this file to .env only when you need to override defaults.
# Atlas works out of the box with no .env file.

# Server port (default: 3100)
PORT=3100

# MCP HTTP/SSE server port (default: 3101)
MCP_PORT=3101

# Dev-only: bypass API-key auth entirely. Never set in production.
ATLAS_AUTH_BYPASS=false

# Colon-separated paths the project scaffolder is allowed to write inside.
# Defaults to ~ plus ~/Documents, ~/code, ~/dev, ~/Projects, and /tmp.
# ATLAS_ALLOWED_PARENT_ROOTS=/Users/you/code:/Users/you/projects

# Show the in-progress Marketplace nav entry (default: false)
VITE_ATLAS_MARKETPLACE_ENABLED=false

# Set to false to use the legacy always-full shell (default: true)
VITE_ATLAS_NEW_SHELL=true

# Show tour analytics table in Settings → Onboarding + ?tour-debug=1 overlay (default: false)
VITE_ATLAS_TOUR_DEBUG=false
