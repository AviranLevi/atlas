  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4"
  },
  "devDependencies": {
    "typescript": "^6.0"
  }
}
