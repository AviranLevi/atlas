{
  "name": "@atlas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Atlas server — Hono REST API + MCP server + Drizzle SQLite",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "reset-auth": "tsx scripts/reset-auth.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.77",
    "@ai-sdk/google": "^3.0.73",
    "@ai-sdk/openai": "^3.0.63",
    "@anthropic-ai/sdk": "^0.96.0",
    "@atlas/shared": "workspace:*",
    "@hono/node-server": "^2.0",
    "@hono/zod-validator": "^0.8",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^6.0.182",
    "better-sqlite3": "^12.10",
    "drizzle-orm": "^0.45",
    "hono": "^4.12",
    "minimatch": "^10.2.4",
    "node-cron": "^4.2.1",
    "openai": "^6.37.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "drizzle-kit": "^0.31",
    "tsx": "^4.19",
    "typescript": "^6.0"
  }
}
