{
  "name": "@atlas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Atlas server — Hono REST API + MCP server + Drizzle SQLite",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "reset-auth": "tsx scripts/reset-auth.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/google": "^3.0.63",
    "@ai-sdk/openai": "^3.0.53",
    "@anthropic-ai/sdk": "^0.80.0",
    "@atlas/shared": "workspace:*",
    "@hono/node-server": "^1.13",
    "@hono/zod-validator": "^0.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^6.0.161",
    "better-sqlite3": "^11.7",
    "drizzle-orm": "^0.38",
    "hono": "^4.7",
    "minimatch": "^10.2.4",
    "node-cron": "^4.2.1",
    "openai": "^6.32.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "drizzle-kit": "^0.30",
    "tsx": "^4.19",
    "typescript": "^5.7"
  }
}
