{
  "name": "@atlas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Atlas server — Hono REST API + MCP server + Drizzle SQLite",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "reset-auth": "tsx scripts/reset-auth.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.23",
    "@ai-sdk/google": "^4.0.26",
    "@ai-sdk/openai": "^4.0.22",
    "@anthropic-ai/sdk": "^0.115.0",
    "@atlas/shared": "workspace:*",
    "@hono/node-server": "^2.0",
    "@hono/zod-validator": "^0.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.40",
    "better-sqlite3": "^13.0",
    "drizzle-orm": "^0.45",
    "hono": "^4.12",
    "minimatch": "^10.2.6",
    "node-cron": "^4.6.0",
    "openai": "^7.0.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "drizzle-kit": "^0.31",
    "tsx": "^4.23",
    "typescript": "^7.0"
  }
}
